# --- Payload CMS (multi-tenant admin + per-organisation WordPress connections) ---

# Postgres connection string (e.g. from Vercel Marketplace / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret used by Payload to sign sessions/JWTs. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# 32-byte hex key used to encrypt stored WordPress Application Passwords. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- OAuth connector support (Epexta as an OAuth authorization server for Claude/ChatGPT) ---
# Canonical public origin, no trailing slash. It's the OAuth issuer and the prefix of every
# MCP connector URL, which clients compare exactly - so set it explicitly in production.
# Falls back to the Vercel production/branch URL, then http://localhost:$PORT. See lib/app-url.ts.
APP_URL=http://localhost:3000

# Shared secret Vercel Cron sends to /api/cron/oauth-cleanup (see vercel.json). Generate with:
# openssl rand -hex 32. Without it the cleanup job refuses to run.
CRON_SECRET=

# --- Google Site Hub (google-search-console, google-analytics modules) ---
# One OAuth client (Google Cloud Console) serves both modules - the requested scope,
# not the client, is what stays module-specific. See modules/google-connections/.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/google-connections/oauth/callback

# The Google Cloud project the OAuth client above belongs to - used only to key the
# per-project half of GA4's two-layer quota tracking (ga4-project-property-quota; see
# "GA4's quota boundary..." in GOOGLE_PERFORMANCE_PLAN.md). A fixed, known value, not
# read per-request.
GOOGLE_CLOUD_PROJECT_ID=
