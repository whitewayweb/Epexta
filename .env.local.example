# Legacy single-site mode (still used as a fallback if no per-user connection is found)
# Your WordPress site's base URL, no trailing slash
WP_SITE_URL=https://example.com

# A WordPress user with permission to create/publish posts and upload media
WP_USERNAME=your-wp-username

# Generate under WP Admin -> Users -> Profile -> Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Payload CMS (multi-tenant admin + per-user WordPress connections) ---

# Postgres connection string (e.g. from Vercel Marketplace / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret used by Payload to sign sessions/JWTs. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# 32-byte hex key used to encrypt stored WordPress Application Passwords. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
